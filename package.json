{
  "name": "2026-tracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --port 8787",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "pnpm run build && wrangler deploy",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate && tsx scripts/convert-migrations.ts",
    "db:migrate": "wrangler d1 migrations apply 2026-tracker-db --local",
    "db:migrate:prod": "wrangler d1 migrations apply 2026-tracker-db --remote",
    "db:studio": "drizzle-kit studio",
    "prepare": "husky",
    "update:all": "taze -I -f -l"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.2.8",
    "@iconify/vue": "5.0.1",
    "drizzle-orm": "1.0.0-rc.2",
    "hono": "4.12.8",
    "ky": "2.0.2",
    "pinia": "3.0.4",
    "valibot": "1.4.0",
    "vue": "3.5.34",
    "vue-i18n": "11.4.2",
    "vue-router": "5.0.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260515.1",
    "@hono/valibot-validator": "0.6.1",
    "@types/node": "25.8.0",
    "@vitejs/plugin-vue": "6.0.7",
    "@vitest/browser-playwright": "4.1.6",
    "@vitest/ui": "4.1.6",
    "@vue/tsconfig": "0.9.1",
    "drizzle-kit": "1.0.0-rc.2",
    "eslint-config-greenpie": "16.0.0-12",
    "happy-dom": "20.8.4",
    "husky": "9.1.7",
    "msw": "2.14.6",
    "oxlint": "1.64.0",
    "oxlint-tsgolint": "0.22.1",
    "taze": "19.12.0",
    "tsx": "4.22.0",
    "typescript": "6.0.3",
    "vite": "8.0.1",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.6",
    "vitest-browser-vue": "2.1.0",
    "vue-tsc": "3.2.9",
    "workbox-window": "7.4.1",
    "wrangler": "4.92.0"
  },
  "packageManager": "pnpm@10.32.1",
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
